datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Store {
  id             Int              @id @default(autoincrement())
  name           String
  owner          String?
  alamat         String?
  phone          String
  username       String           @unique
  password       String           @default("123456")
  commissionRate Float            @default(15.0)
  photoUrl       String?
  inventories    StoreInventory[]
  orders         Order[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
}

model Product {
  id          Int              @id @default(autoincrement())
  sku         String           @unique
  name        String
  category    String           @default("TOPI")
  price       Float
  photoUrl    String?
  inventories StoreInventory[]
  orderItems  OrderItem[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model StoreInventory {
  id        Int      @id @default(autoincrement())
  storeId   Int
  productId Int
  stock     Int      @default(0)
  qrCodeKey String   @unique
  store     Store    @relation(fields: [storeId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([storeId, productId])
}

model Order {
  id          Int         @id @default(autoincrement())
  orderNumber String      @unique
  storeId     Int
  totalAmount Float
  paymentFee  Float       @default(0)
  status      String      @default("PENDING")
  store       Store       @relation(fields: [storeId], references: [id])
  items       OrderItem[]
  createdAt   DateTime    @default(now())
}

model OrderItem {
  id                    Int     @id @default(autoincrement())
  orderId               Int
  productId             Int
  price                 Float
  storeCommissionRate   Float
  storeCommissionAmount Float
  netSupplierAmount     Float
  order                 Order   @relation(fields: [orderId], references: [id])
  product               Product @relation(fields: [productId], references: [id])
}